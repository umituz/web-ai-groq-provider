{
  "name": "@umituz/web-ai-groq-provider",
  "version": "2.3.0",
  "description": "Groq AI text generation and chat provider for React web applications",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./groq": {
      "types": "./dist/domains/groq/index.d.ts",
      "import": "./dist/domains/groq/index.js",
      "require": "./dist/domains/groq/index.cjs"
    },
    "./chat": {
      "types": "./dist/domains/chat/index.d.ts",
      "import": "./dist/domains/chat/index.js",
      "require": "./dist/domains/chat/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:scenarios": "echo 'See TEST_SCENARIOS.md for manual test scenarios'",
    "version:patch": "npm version patch -m 'chore: release v%s'",
    "version:minor": "npm version minor -m 'chore: release v%s'",
    "version:major": "npm version major -m 'chore: release v%s'"
  },
  "keywords": [
    "groq",
    "ai",
    "llm",
    "text-generation",
    "react",
    "web",
    "streaming",
    "llama"
  ],
  "author": "umituz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/umituz/web-ai-groq-provider"
  },
  "peerDependencies": {
    "react": ">=18.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "eslint": "^9.32.0",
    "react": "18.3.1",
    "tsup": "^8.0.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.38.0",
    "vitest": "^3.2.7"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
